# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini / Backend Configuration
VITE_API_BASE_URL=http://localhost:3001
GEMINI_API_KEY=your_gemini_api_key

# Sogni SDK Configuration (Project ID only, API Key in localStorage)
VITE_SOGNI_PROJECT_ID=Song2Video
VITE_DEFAULT_MODEL=ltx-2.3
VITE_SOGNI_API_KEY=

# Application Settings
VITE_APP_TITLE=Song-to-Video Studio (v3.0)
VITE_MAX_SEGMENTS=20
VITE_MIN_SEGMENT_DURATION=5.0
VITE_MAX_SEGMENT_DURATION=7.0
